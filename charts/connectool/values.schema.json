{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["cluster", "consumer", "contract", "accessGrants"],
  "properties": {
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner", "organizationBoundary", "apiEndpoint"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "organizationBoundary": {"const": "external"},
        "apiEndpoint": {"type": "string", "pattern": "^https://"}
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "oidcIssuer", "identitySource", "usernamePrefix", "scopes"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "oidcIssuer": {"type": "string", "pattern": "^https://"},
        "identitySource": {"type": "string", "minLength": 1},
        "usernamePrefix": {"type": "string", "minLength": 1},
        "scopes": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship", "dataPlaneSharing", "credentialPolicy", "ownerRevocationAuthoritative"],
      "properties": {
        "relationship": {"const": "api-access-only"},
        "dataPlaneSharing": {"const": "prohibited"},
        "credentialPolicy": {"const": "oidc-no-static-credentials"},
        "ownerRevocationAuthoritative": {"const": true}
      }
    },
    "accessGrants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "roleRef", "subjects"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
          "roleRef": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "name"],
            "properties": {
              "kind": {"const": "ClusterRole"},
              "name": {"type": "string", "minLength": 1}
            }
          },
          "rules": {"type": "array"},
          "subjects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "name"],
              "properties": {
                "kind": {"enum": ["User", "Group"]},
                "name": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
